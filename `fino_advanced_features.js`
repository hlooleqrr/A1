const QUESTIONS_KEY = 'finoCustomQuestions';

function loadCustomQuestions() {
  try {
    const data = localStorage.getItem(QUESTIONS_KEY);
    return data ? JSON.parse(data) : null;
  } catch (e) {
    return null;
  }
}

function saveCustomQuestions(questions) {
  localStorage.setItem(QUESTIONS_KEY, JSON.stringify(questions));
}

function getQuestionOrder() {
  const custom = loadCustomQuestions();
  if (custom && custom.order) {
    return custom.order;
  }
  return null;
}

function getHiddenQuestions() {
  const custom = loadCustomQuestions();
  if (custom && custom.hidden) {
    return custom.hidden;
  }
  return [];
}

function isQuestionHidden(questionId) {
  return getHiddenQuestions().includes(questionId);
}

function toggleQuestionVisibility(questionId) {
  const custom = loadCustomQuestions() || { order: [], hidden: [], labels: {} };
  
  if (custom.hidden.includes(questionId)) {
    custom.hidden = custom.hidden.filter(id => id !== questionId);
  } else {
    custom.hidden.push(questionId);
  }
  
  saveCustomQuestions(custom);
}

function updateQuestionLabel(questionId, newLabel) {
  const custom = loadCustomQuestions() || { order: [], hidden: [], labels: {} };
  custom.labels[questionId] = newLabel;
  saveCustomQuestions(custom);
}

function getQuestionLabel(questionId, defaultLabel) {
  const custom = loadCustomQuestions();
  if (custom && custom.labels && custom.labels[questionId]) {
    return custom.labels[questionId];
  }
  return defaultLabel;
}

