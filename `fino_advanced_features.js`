// ====== نظام الطقس ======
async function fetchWeather() {
  const settings = loadPlatformSettings();
  if (!settings.showWeather) return;
  
  try {
    // استخدام API مجاني للطقس
    const response = await fetch('https://api.open-meteo.com/v1/forecast?latitude=24.7136&longitude=46.6753&current_weather=true');
    const data = await response.json();
    
    if (data.current_weather) {
      displayWeather(data.current_weather);
    }
  } catch (e) {
    console.log('FINO: تعذر جلب بيانات الطقس', e);
  }
}

function displayWeather(weather) {
  const container = document.getElementById('weatherWidget');
  if (!container) return;
  
  const temp = Math.round(weather.temperature);
  const weatherCode = weather.weathercode;
  
  let icon = '☀️';
  let desc = 'صحو';
  
  if (weatherCode >= 1 && weatherCode <= 3) {
    icon = '⛅';
    desc = 'غائم جزئياً';
  } else if (weatherCode >= 45 && weatherCode <= 48) {
    icon = '🌫️';
    desc = 'ضباب';
  } else if (weatherCode >= 51 && weatherCode <= 67) {
    icon = '🌧️';
    desc = 'ممطر';
  } else if (weatherCode >= 71 && weatherCode <= 77) {
    icon = '❄️';
    desc = 'ثلج';
  } else if (weatherCode >= 80 && weatherCode <= 82) {
    icon = '🌦️';
    desc = 'زخات مطر';
  } else if (weatherCode >= 95) {
    icon = '⛈️';
    desc = 'عاصفة رعدية';
  }
  
  container.innerHTML = `
    <div class="weather-widget">
      <div class="weather-icon">${icon}</div>
      <div class="weather-info">
        <div class="weather-temp">${temp}°C</div>
        <div class="weather-desc">${desc}</div>
        <div class="weather-location">الرياض</div>
      </div>
    </div>
  `;
  container.style.display = 'block';
}

// ====== حساب تاريخ انتهاء التمويل ======
function calculateFinanceEndDate(months) {
  const now = new Date();
  const endDate = new Date(now.getTime() + months * 30 * 24 * 60 * 60 * 1000);
  
  // التاريخ الميلادي
  const gregorianDate = endDate.toLocaleDateString('ar-SA', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
  
  // التاريخ الهجري
  let hijriDate = '';
  try {
    hijriDate = endDate.toLocaleDateString('ar-SA-u-ca-islamic-umalqura', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    });
  } catch (e) {
    hijriDate = 'غير متاح';
  }
  
  return {
    gregorian: gregorianDate,
    hijri: hijriDate,
    date: endDate
  };
}

// ====== تهيئة الميزات المتقدمة ======
function initAdvancedFeatures() {
  // تتبع الزائر
  trackVisitor();
  
  // تطبيق الموسم المحفوظ
  const savedSeason = loadSeasonTheme();
  applySeasonTheme(savedSeason);
  
  // تطبيق الثيم المحفوظ
  const savedTheme = loadTheme();
  applyTheme(savedTheme);
  
  // تطبيق إعدادات المنصة
  applyPlatformSettings();
  
  // جلب الطقس
  fetchWeather();
  
  // تحديث إحصائيات الزوار
  updateVisitorStats();
  
  // التحقق من PWA
  if (!localStorage.getItem('pwaPromptDismissed')) {
    setTimeout(showInstallPrompt, 3000);
  }
}

// تشغيل عند تحميل الصفحة
document.addEventListener('DOMContentLoaded', initAdvancedFeatures);